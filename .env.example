# Local development only. Copy to .env.local; never commit real values.
FRAMEREADY_ENVIRONMENT=development
NEXT_PUBLIC_FRAMEREADY_ENVIRONMENT=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel supplies VERCEL_BRANCH_URL automatically in Preview deployments.

NEXT_PUBLIC_SUPABASE_URL=https://preview-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-preview-anon-key
NEXT_PUBLIC_SUPABASE_PROJECT_REF=preview-project-ref
NEXT_PUBLIC_PRODUCTION_SUPABASE_PROJECT_REF=production-project-ref
SUPABASE_PROJECT_REF=preview-project-ref
SUPABASE_PRODUCTION_PROJECT_REF=production-project-ref
SUPABASE_SERVICE_ROLE_KEY=replace-with-preview-service-role-key

STRIPE_SECRET_KEY=sk_test_replace_with_correct_frameready_sandbox_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_local_stripe-cli-secret
STRIPE_EXPECTED_ACCOUNT_ID=acct_replace_with_frameready_account-id

# Exact variable name read by the app. EMAIL_MODE is not used.
EMAIL_DELIVERY_MODE=redirect
EMAIL_TEST_RECIPIENT=developer@example.com
RESEND_API_KEY=re_replace_with_non-production-key
DELIVERY_FROM_EMAIL=FrameReady Preview <onboarding@resend.dev>

ADMIN_EMAIL=developer@example.com
ADMIN_PASSWORD=replace-with-a-local-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-local-secret
